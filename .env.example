# Superuser: used only by Alembic and Postgres init.
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me

# Service role (no UPDATE/DELETE on audit_log) and the MCP history tool role.
APP_DB_PASSWORD=change-me-app
HISTORY_RO_PASSWORD=change-me-history

MIGRATION_DATABASE_URL=postgresql+asyncpg://civicpulse:change-me@localhost:5432/civicpulse
DATABASE_URL=postgresql+asyncpg://app:change-me-app@localhost:5432/civicpulse
KAFKA_BOOTSTRAP=localhost:19092
REDIS_URL=redis://localhost:6379/0

# Fernet key for raw complaint text: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_KEY=

AGENTS_URL=http://localhost:8001
